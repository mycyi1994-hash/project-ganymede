# Safe default: all orders and GIWA settlements are simulated.
TRADING_MODE=paper

# Required only for explicitly enabled live Upbit execution.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
LIVE_TRADING_CONFIRMATION=

# Protects operator endpoints. In a private Sites deployment, allowlisted
# authenticated emails can also operate the engine.
OPERATOR_TOKEN=
OPERATIONS_ALLOW_EMAILS=

# GIWA Sepolia defaults to the public rate-limited RPC when omitted.
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_RELAYER_URL=
GIWA_RELAYER_TOKEN=
GIWA_FUND_SHARE_ADDRESS=
GIWA_NAV_REGISTRY_ADDRESS=
