# Deployment keys. Generate locally, never commit, never reuse a mainnet key.
#
# ADMIN    cold — administrator on both contracts, transfer agent on the share
#                 ledger. Deploy, allowlist, pause, role changes.
# RELAYER  hot  — issuer + publisher. Mint, burn, publish. Nothing else.
#                 The same key is configured as a secret on the relayer Worker.
ADMIN_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Defaults to the public GIWA Sepolia RPC when omitted.
GIWA_RPC_URL=https://sepolia-rpc.giwa.io

# Blockscout ignores the key but hardhat-verify requires the field.
EXPLORER_API_KEY=blockscout

# Which engine product the share ledger represents. Must match an id in
# lib/engine/seed.ts.
FUND_SHARE_PRODUCT_ID=core-20
FUND_SHARE_NAME=Ganymede Core 20
FUND_SHARE_SYMBOL=GMDCORE
