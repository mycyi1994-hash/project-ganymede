{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganymede-arbitrage-keeper",
  "main": "src/keeper.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Every five minutes, like the NAV record it trades against. See src/keeper.ts.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // GanymedeNavArbitrage and GanymedeDemoDollar on X Layer Testnet
    // (onchain/deployments/xlayer-testnet.json).
    "ARBITRAGE_ADDRESS": "0xaeba15aa92d6f3109e2b992f18933e1abe2fa3d9",
    "DOLLAR_ADDRESS": "0xf07535080f74e8b0f571e58dfa600f47e72ea9bf"
    // KEEPER_PRIVATE_KEY is a secret, never a var:
    //   npx wrangler secret put KEEPER_PRIVATE_KEY -c wrangler.keeper.jsonc
  }
}
